{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build-preview-site.py && rm -rf public && mv dist public",
  "installCommand": "echo skip",
  "trailingSlash": false,
  "functions": {
    "api/pass.py": {
      "includeFiles": "{issuer/**,pass/**}"
    }
  },
  "headers": [
    {
      "source": "/pass/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
